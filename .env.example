# Environment Variables Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Local development (SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL e.g., Supabase / Neon / AWS RDS):
# DATABASE_URL="postgresql://mess_user:YourSecurePassword@host:5432/smart_mess?schema=public"

# Security & Sessions
SESSION_SECRET="replace-with-a-secure-random-at-least-32-character-secret"
# 32-byte hex key (64 hex characters) for AES-256-GCM biometric template encryption
BIOMETRIC_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Hostel & College Settings
HOSTEL_NAME="Premier College Hostel Mess"
HOSTEL_TIMEZONE="Asia/Kolkata"

# Face Verification Threshold (Euclidean distance: lower means stricter)
FACE_MATCH_THRESHOLD="0.50"

# CORS trusted origins (Comma separated if multiple)
FRONTEND_URL="http://localhost:3000"
